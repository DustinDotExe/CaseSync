{
  "entities": {
    "participant": {
      "title": "Participant",
      "description": "A court participant being tracked.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the participant." },
        "caseNumber": { "type": "string", "description": "Unique case identifier." },
        "currentPhase": { "type": "integer", "description": "Current phase (1-5)." },
        "goals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of SMART goals."
        },
        "completedGoals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of completed SMART goals."
        },
        "notes": { "type": "string", "description": "Case manager notes." },
        "milestones": {
          "type": "object",
          "description": "Checkboxes for phases 1-5.",
          "properties": {
            "phase1": { "type": "boolean" },
            "phase2": { "type": "boolean" },
            "phase3": { "type": "boolean" },
            "phase4": { "type": "boolean" },
            "phase5": { "type": "boolean" }
          }
        },
        "uid": { "type": "string", "description": "The UID of the case manager who owns this record." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "caseNumber", "currentPhase", "uid"]
    },
    "user": {
      "title": "User",
      "description": "A court case manager user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["case_manager", "admin"] }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/participants/{participantId}": {
      "schema": "participant",
      "description": "Collection of participants."
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "Collection of users."
    }
  }
}
