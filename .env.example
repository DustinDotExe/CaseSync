# GEMINI_API_KEY: Required for Gemini AI API calls.
# Kept SERVER-SIDE ONLY — never exposed to the browser bundle.
# In dev: loaded by server.ts via dotenv. In production (Cloud Run): set as a secret env var.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional. Defaults to the stable low-latency model below.
# Use this if you need to test a different Gemini model.
GEMINI_MODEL="gemini-2.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration
# These are required for the app to connect to the Firebase backend.
# You can find these in your firebase-applet-config.json or the Firebase Console.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123
VITE_FIREBASE_FIRESTORE_DATABASE_ID=your-database-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
